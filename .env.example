# Blank placeholders only. Load this file explicitly; npm scripts do not auto-load it.
# Use project Secrets on Replit. Never commit .env or actual credentials.
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=5000
NODE_ENV=development

# Configure these for your deployment; do not substitute the workspace preview URL.
FRONTEND_URL=
APP_URL=

# Replit-managed Anthropic connection, required for live AI requests.
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# Required by the current subscription module at startup. Use a test key for review.
STRIPE_SECRET_KEY=

# Optional services.
GOOGLE_MAPS_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Deal Room phase 1: opt-in database-backed persistence.
# Apply migrations/20261030_dealroom_foundation.sql before enabling.
# Use 'postgres' for durable sessions/NDAs/grants/audits; unset = legacy in-memory demo.
DEALROOM_STORAGE=
# Public reviewer role-switching is OFF by default in production.
# Enable only for synthetic MNA-2047 portfolio demonstrations, never for real listing administration.
DEALROOM_DEMO_ACCESS=false
# Verified DocuSign/Dropbox Sign signing is NOT configured in this milestone.

# Phase 2: optional Dropbox Sign verified-template NDA integration.
# Apply migrations/20261030_dealroom_signatures.sql after the foundation migration.
# Requires DEALROOM_STORAGE=postgres and an approved Dropbox Sign template/signing role.
DEALROOM_SIGNATURE_PROVIDER=
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_TEMPLATE_ID=
DROPBOX_SIGN_SIGNER_ROLE=Buyer
DROPBOX_SIGN_CLIENT_ID=
# Test requests are non-binding, sent to real email recipients but NEVER grant real-inventory access.
DROPBOX_SIGN_TEST_MODE=true
# LIVE mode requires BOTH flags, legal review and a paid provider subscription.
DEALROOM_LIVE_SIGNATURES_ENABLED=false
DEALROOM_NDA_LEGAL_APPROVED=false
# Do not enable until classified inventory is omitted from public catalogue and vault is safe.
DEALROOM_REAL_INVENTORY_CLASSIFIED=false
# Configure Dropbox Sign account or API App callback:
# https://YOUR-DEPLOYMENT/api/dealroom/webhooks/dropbox

# Phase 3: synthetic encrypted document vault.
# Apply migrations/20261030_dealroom_vault.sql after foundation and signatures.
DEALROOM_VAULT_ENABLED=false
# 32 random bytes as hex (64 hexadecimal characters), stored ONLY in Replit Secrets.
# BACK UP this key separately. Losing it makes stored PDFs unrecoverable.
DEALROOM_DOCUMENT_ENCRYPTION_KEY=
