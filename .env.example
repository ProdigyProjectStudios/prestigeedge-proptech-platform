# Blank placeholders only. Load this file explicitly; npm scripts do not auto-load it.
# Use project Secrets on Replit. Never commit .env or actual credentials.
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=5000
NODE_ENV=development

# Configure these for your deployment; do not substitute the workspace preview URL.
FRONTEND_URL=
APP_URL=

# Replit-managed Anthropic connection, required for live AI requests.
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# Required by the current subscription module at startup. Use a test key for review.
STRIPE_SECRET_KEY=

# Optional services.
GOOGLE_MAPS_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Deal Room phase 1: opt-in database-backed persistence.
# Apply migrations/20261030_dealroom_foundation.sql before enabling.
# Use 'postgres' for durable sessions/NDAs/grants/audits; unset = legacy in-memory demo.
DEALROOM_STORAGE=
# Public reviewer role-switching is OFF by default in production.
# Enable only for synthetic MNA-2047 portfolio demonstrations, never for real listing administration.
DEALROOM_DEMO_ACCESS=false
# Verified DocuSign/Dropbox Sign signing is NOT configured in this milestone.
